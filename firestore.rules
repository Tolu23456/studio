rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for the 'users' collection.
    match /users/{userId} {
      // A user can read their own profile.
      // An admin can read any user's profile.
      // Writes are blocked from the client to protect sensitive data like cubeBalance. All writes must go through secure server-side functions.
      allow read: if request.auth.uid == userId || request.auth.token.admin == true;
      allow write: if false;
    }

    match /users/{userId}/{subcollection}/{docId} {
      // A user can read from their own subcollections (activities, transactions, etc.).
      // An admin can read from any user's subcollections.
      // Writes are blocked from the client.
      allow read: if request.auth.uid == userId || request.auth.token.admin == true;
      allow write: if false;
    }
  }
}
