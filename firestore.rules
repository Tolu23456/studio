rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Who can read documents?
      // 1. The user themselves.
      // 2. An admin.
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);

      // Who can create documents?
      // Only the user themselves.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Who can write (update/delete) documents?
      // 1. The user themselves.
      // 2. An admin.
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      
      // Rules for user subcollections (e.g., activities, transactions)
      match /{path=**} {
        // Who can read/write subcollection documents?
        // 1. The user themselves.
        // 2. An admin.
        allow read, write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      }
    }
  }
}
