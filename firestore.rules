
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow a user to read, update, and delete their own document.
    // Allow any authenticated user to create their user document (for sign-up).
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }

    // Allow a user to read and write to their own 'activities' subcollection.
    match /users/{userId}/activities/{activityId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Allow a user to read and write to their own 'transactions' subcollection.
    match /users/{userId}/transactions/{transactionId} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}
