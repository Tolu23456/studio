rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow an authenticated user to create, read, update, and delete their own user profile document.
    // This rule is essential for registration (create) and for fetching profile data (read).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow an authenticated user to perform all actions (read, write, list) on documents
    // within any of their own subcollections (e.g., activities, transactions, notifications).
    // This single rule secures all current and future subcollection data.
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
